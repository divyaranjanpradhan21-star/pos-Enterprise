# -----------------------------------------------------------------------------
# Enterprise Restaurant POS API — Production Environment Variable Template
# Copy to .env in production (or set via Render dashboard environment variables)
# -----------------------------------------------------------------------------

# Application Environment
NODE_ENV=production
PORT=3000

# PostgreSQL 16 Database Connection (Supabase Transaction Pooler)
# Format: postgresql://postgres.[project-ref]:[DB_PASSWORD]@aws-0-[region].pooler.supabase.com:65432/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.hploabbozxurvwxhurtj:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:65432/postgres?pgbouncer=true

# Direct Unpooled Database Connection (for Prisma Migrations)
DIRECT_URL=postgresql://postgres.hploabbozxurvwxhurtj:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# JWT Secret Key (Use a strong 64-character secret in production)
JWT_SECRET=super-secret-production-jwt-token-key-change-me-in-production

# CORS Allowed Origin (Set to your Vercel frontend URL)
CORS_ORIGIN=https://pos-enterprise.vercel.app

# Supabase Anonymous Keys (Client side & webhook verifications)
SUPABASE_URL=https://hploabbozxurvwxhurtj.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
